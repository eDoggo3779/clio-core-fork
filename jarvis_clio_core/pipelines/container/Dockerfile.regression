# =============================================================================
# Dockerfile.regression — prebuilt image for the #526 CONTAINER pipelines
# (single_node.yaml / distributed.yaml with base_deploy_mode: container).
# =============================================================================
#
# The jarvis dev ContainerInstaller pulls this image (container_uri) and runs
# the WHOLE pipeline inside ONE container per node (entrypoint:
# `jarvis ppl run yaml ...`, network_mode host, ipc host, as root). Every
# package — redis, juicefs, fio, clio_* — runs bare-metal inside it, so a FUSE
# mount made by juicefs/CTE is visible to fio in the same mount namespace.
#
# THE BUILD IS THE "installs run cleanly" GATE: the final RUN fails the build if
# any required binary is missing.
#
# Tailored to the IOWarp build base (verified on Ares): it runs as the non-root
# user `iowarp`, ships spack at /home/iowarp/spack, and has NO clio_* built — so
# system installs run as root, the IOWarp build runs as `iowarp` (it owns spack),
# and the runtime user is root (the jarvis compose entrypoint uses /root).
#
# Build from the REPO ROOT (the COPY below bakes in the local jarvis_clio_core
# edits: redis _get_stat, juicefs_bench fallocate):
#   docker build -f jarvis_clio_core/pipelines/container/Dockerfile.regression \
#     --build-arg IOWARP_SPEC='iowarp@main +fuse' \
#     -t atharva3779/iowarp-regression:526 .
#   docker push atharva3779/iowarp-regression:526
# (Confirm the fuse variant first: `spack info iowarp` inside the base image.)

ARG BASE_IMAGE=iowarp/iowarp-build:latest
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
# IOWarp spec — the FUSE-adapter variant is SITE-SPECIFIC. NOTE: on this base
# image's spack, BOTH `+fuse` and `+libfuse` fail to concretize, so neither is
# the right name. Run `spack info iowarp` in the base image to find the real
# variant that enables the libfuse adapter (or it may build by default). Whatever
# spec you pass MUST yield clio_run, clio_cte_fuse, clio_cte_bench (+ clio_redis_bench
# if the recipe has a redis option). Override at build with --build-arg IOWARP_SPEC=...
ARG IOWARP_SPEC=iowarp@main
ARG JUICEFS_VERSION=1.2.3
ARG JARVIS_REF=2925ee8                       # MUST match the Ares jarvis pin
ARG SPACK_SETUP=/home/iowarp/spack/share/spack/setup-env.sh
ARG SPACK_USER=iowarp

# 1) System deps as ROOT (the base defaults to USER iowarp -> apt is denied).
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        fuse3 libfuse3-3 \
        openmpi-bin libopenmpi-dev \
        redis-server redis-tools \
        fio \
        git curl ca-certificates \
        python3 python3-pip python3-venv \
        openssh-server openssh-client \
    && rm -rf /var/lib/apt/lists/*

# 2) JuiceFS — official single static binary (to a root-owned PATH dir).
RUN curl -fsSL "https://github.com/juicedata/juicefs/releases/download/v${JUICEFS_VERSION}/juicefs-${JUICEFS_VERSION}-linux-amd64.tar.gz" \
      | tar -xz -C /usr/local/bin juicefs \
    && juicefs version

# 3) A spack "view" dir the iowarp user can populate and root can read at runtime.
RUN mkdir -p /opt/iowarp-view && chown ${SPACK_USER}:${SPACK_USER} /opt/iowarp-view

# 4) IOWarp + FUSE adapter via spack, as the user that OWNS spack.
USER ${SPACK_USER}
RUN . "${SPACK_SETUP}" \
    && spack install --fail-fast ${IOWARP_SPEC} \
    && spack view --dependencies yes symlink -i /opt/iowarp-view ${IOWARP_SPEC}

# 5) Back to root: put the view on PATH, install jarvis at the pinned ref,
#    register this repo, prepare sshd. Runtime user stays root (compose /root).
USER root
ENV PATH=/opt/iowarp-view/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/iowarp-view/lib:/opt/iowarp-view/lib64:${LD_LIBRARY_PATH}

RUN git clone https://github.com/grc-iit/jarvis-cd.git /opt/jarvis-cd \
    && git -C /opt/jarvis-cd checkout ${JARVIS_REF} \
    && { pip3 install -e /opt/jarvis-cd \
         || pip3 install --break-system-packages -e /opt/jarvis-cd; }

# jarvis_clio_core — COPY from the build context so the local edits are baked in,
# then init jarvis (root -> /root/.ppi-jarvis/config) and register the repo so
# `jarvis_clio_core.*` pkg_types resolve inside the container.
COPY jarvis_clio_core /opt/clio-core/jarvis_clio_core
RUN jarvis init \
    && jarvis repo add /opt/clio-core/jarvis_clio_core \
    && jarvis repo list

RUN mkdir -p /run/sshd /root/.ssh && chmod 700 /root/.ssh

# 6) GATE — fail the build if a REQUIRED binary is missing; warn (non-fatal) on
#    clio_redis_bench (needs a redis-enabled IOWarp build; only affects the
#    single_node redis experiment column).
RUN for b in clio_run clio_cte_fuse clio_cte_bench \
             juicefs fio redis-server redis-cli redis-benchmark mpiexec jarvis; do \
        command -v "$b" >/dev/null || { echo "MISSING REQUIRED BINARY: $b"; exit 1; }; \
    done \
    && { command -v clio_redis_bench >/dev/null \
         || echo "WARN: clio_redis_bench not built (no redis variant in IOWARP_SPEC); the single_node redis column will be empty"; } \
    && echo "iowarp-regression image: required binaries present"
